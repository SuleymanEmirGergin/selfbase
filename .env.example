# Copy to .env and fill in. Never commit .env.
# JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY: node scripts/gen-keys.mjs

# Database superuser password; also used by PostgREST's authenticator role. URL-safe characters only.
POSTGRES_PASSWORD=

# HS256 secret, at least 32 characters
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Public origin of core (what clients use as SUPABASE_URL)
PUBLIC_URL=
# core sits behind a reverse proxy: take the client IP from the last X-Forwarded-For entry
TRUST_PROXY=true
# App origin; auth redirects fall back here
SITE_URL=
# Comma-separated. An entry without wildcards matches exactly (an entry with no path also matches the bare origin,
# with or without a trailing slash). A trailing * or ** matches any deeper path; * inside the path matches one segment.
AUTH_REDIRECT_ALLOWLIST=
AUTH_CONFIRM_EMAIL=true
AUTH_PHONE_ENABLED=false
AUTH_MIN_PASSWORD=6
# Link / OTP lifetime and minimum gap between auth mails to one user, seconds
# AUTH_OTP_EXPIRY=3600
# AUTH_EMAIL_INTERVAL=60
# Standard Webhooks secret for FN_URL/send-phone-otp-hook (with AUTH_PHONE_ENABLED=true), "v1,whsec_<base64>"
# AUTH_SMS_HOOK_SECRET=

# Empty SMTP_HOST: mails are written to selfbase.mail_log instead of sent
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google endpoint overrides (tests point these at a local fake); unset keeps the Google defaults
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Admin panel login. Set these with: node scripts/set-panel-password.mjs
# (it writes the bcrypt hash with `$` escaped as `$$` for docker compose).
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD_HASH=

# Host address core is published on. 127.0.0.1 (default): reachable only from this machine, i.e. via a reverse proxy.
# Set 0.0.0.0 only when no reverse proxy runs on the same host. CORE_PORT is the port number only.
# CORE_BIND=127.0.0.1
# CORE_PORT=8080
STORAGE_DIR=/data/storage
# Largest accepted upload (storage API and panel), bytes; default 52428800 (50 MiB)
# STORAGE_MAX_UPLOAD_BYTES=52428800
# path to the app repo's supabase/ folder (contains functions/ and config.toml); empty = no functions
SUPABASE_DIR=
PGRST_URL=http://rest:3000
FN_URL=http://fn:8000
# Max time (ms) to import one function module on first call; default 30000
# FN_IMPORT_TIMEOUT_MS=30000

# Migration scripts (scripts/migrate/README.md). Same database, two views of it:
# container-side steps 01-03 (service name + DOCKER_NETWORK) and host-side steps 05, 06 (published port).
# Same password in both; 05/06 use TARGET_DB_URL_HOST when set, else TARGET_DB_URL. Supabase hosts are refused.
# DOCKER_NETWORK=<COMPOSE_PROJECT_NAME>_default
# TARGET_DB_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
# TARGET_DB_URL_HOST=postgres://postgres:<POSTGRES_PASSWORD>@localhost:55432/postgres
