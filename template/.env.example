# Local stack: copy to .env at the repository root and fill in. Never commit .env.
#   docker compose -f template/compose.yml -f template/compose.build.yml --env-file .env up -d --build
# On a server the provisioner sets these per project; nothing reads this file there.
# JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY: node scripts/gen-keys.mjs

# Image names: ${REGISTRY}/selfbase-<service>:${TEMPLATE_VERSION}; locally just the tags the build gives the images
REGISTRY=selfbase
TEMPLATE_VERSION=dev

# Database superuser password (also the pooler's login). URL-safe characters only.
POSTGRES_PASSWORD=
# Password core sets on PostgREST's authenticator role and rest logs in with. URL-safe characters only.
AUTHENTICATOR_PASSWORD=
# Postgres settings; on a server they follow the project size (template/sizes.json). Defaults: micro.
# DB_SHARED_BUFFERS=128MB
# DB_MAX_CONNECTIONS=60
# POOL_SIZE=15
# Exposed schemas and max rows of the REST API
# PGRST_DB_SCHEMAS=public
# PGRST_DB_MAX_ROWS=1000

# HS256 secret, at least 32 characters
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Public origin of core (what clients use as SUPABASE_URL); required, https outside localhost
PUBLIC_URL=
# Unset, compose renders true: core takes the client IP from the last X-Forwarded-For entry, the one your reverse
# proxy adds (core/src/ip.ts). Set false when clients reach core with no proxy in front: with true they could pick their
# own IP. Behind a proxy, false keys every client by the proxy's address, so all of them share one per-IP auth limit.
# TRUST_PROXY=true
# Whose X-Forwarded-For core believes when TRUST_PROXY=true. Unset (keep the line below commented out): `*`, every
# peer, which suits a stack whose core only your reverse proxy can reach. A comma-separated list of IP addresses (your
# proxy's): only those peers. Set but empty (`TRUSTED_PROXY_IPS=` with nothing after it) is NOT the default: it means
# no peer, so every client is keyed by the proxy's address and shares one per-IP auth limit.
# On a selfbase server the provisioner sets it per project to the proxy container's address; a value here is ignored.
# TRUSTED_PROXY_IPS=<your proxy's IP>
# net.http_* (pg_net) requests may not reach private, loopback or link-local addresses, nor a name that resolves to
# one, except these hosts (comma-separated names or IP addresses, matched exactly), e.g. a service on your own network.
# Empty (the default): public addresses only.
# NETQUEUE_ALLOW_HOSTS=
# App origin; auth redirects fall back here; required
SITE_URL=
# Comma-separated. An entry without wildcards matches exactly (an entry with no path also matches the bare origin,
# with or without a trailing slash). A trailing * or ** matches any deeper path; * inside the path matches one segment.
AUTH_REDIRECT_ALLOWLIST=
AUTH_CONFIRM_EMAIL=true
AUTH_PHONE_ENABLED=false
AUTH_MIN_PASSWORD=6
# With AUTH_CONFIRM_EMAIL: an email change needs the link sent to the old AND the one sent to the new address
# AUTH_SECURE_EMAIL_CHANGE=true
# Seconds in which a retried refresh token (lost response, two tabs) gets the same new session; 0 = any reuse ends it
# AUTH_REFRESH_REUSE_INTERVAL=10
# Where a contested sign-up lands to set a password (the account lost its password, the link carries type=recovery).
# Must be in AUTH_REDIRECT_ALLOWLIST; empty = the sign-up's redirect_to. CorteQS: <SITE_URL>/reset-password
# AUTH_SET_PASSWORD_URL=
# Per-IP limits per 5 minutes, 429 over_request_rate_limit beyond them; 0 turns one off.
# SIGN_IN: sign-ins and sign-ups together, VERIFY: /verify, REFRESH: token refresh, EMAIL: /otp, /recover, /resend
# AUTH_RATE_LIMIT_SIGN_IN=30
# AUTH_RATE_LIMIT_VERIFY=30
# AUTH_RATE_LIMIT_REFRESH=150
# AUTH_RATE_LIMIT_EMAIL=30
# Link / OTP lifetime and minimum gap between auth mails to one user, seconds
# AUTH_OTP_EXPIRY=3600
# AUTH_EMAIL_INTERVAL=60
# Standard Webhooks secret for FN_URL/send-phone-otp-hook (with AUTH_PHONE_ENABLED=true), "v1,whsec_<base64>"
# AUTH_SMS_HOOK_SECRET=

# Empty SMTP_HOST: mails are written to selfbase.mail_log instead of sent
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google endpoint overrides (tests point these at a local fake); unset keeps the Google defaults
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Admin API bearer token (Authorization: Bearer <ADMIN_TOKEN>), at least 32 characters, e.g. openssl rand -hex 32.
# Shorter or empty: the admin API is not started. It listens on port 8081, which is never published or proxied.
ADMIN_TOKEN=
# Project ref written on every JSON log line; empty outside the control plane
# PROJECT_REF=
# true: POST /auth/v1/signup answers 422 signup_disabled (OAuth and OTP sign-ins can still create users)
# AUTH_DISABLE_SIGNUP=false

# Local port core is published on (127.0.0.1 only; compose.build.yml)
# CORE_PORT=8080
# Largest accepted upload (storage API and admin API), bytes; default 52428800 (50 MiB)
# STORAGE_MAX_UPLOAD_BYTES=52428800
# Local only: path to the app repo's supabase/ folder (contains functions/ and config.toml); empty = no functions
SUPABASE_DIR=
# Max time (ms) to import one function module on first call; default 30000
# FN_IMPORT_TIMEOUT_MS=30000

# Migration scripts (scripts/migrate/README.md). Same database, two views of it:
# container-side steps 01-03 (service name + DOCKER_NETWORK) and host-side steps 05, 06 (published port).
# Same password in both; 05/06 use TARGET_DB_URL_HOST when set, else TARGET_DB_URL. Supabase hosts are refused.
# DOCKER_NETWORK=<COMPOSE_PROJECT_NAME>_default
# TARGET_DB_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
# TARGET_DB_URL_HOST=postgres://postgres:<POSTGRES_PASSWORD>@localhost:55432/postgres
