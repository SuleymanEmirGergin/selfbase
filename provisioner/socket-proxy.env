# Allow-list for wollomatic/socket-proxy:1.14.0 (spec 7.5). Used as `env_file` of the socket-proxy service.
# One regex per method. The proxy anchors each one (^...$) itself. Every pattern takes an optional /v1.NN
# prefix, and the provisioner always sends one (v1.45).
# Names are matched per path segment, so `..` and encoded slashes cannot leave the sb-* namespace:
#   [a-z0-9_-]+ has no dot or slash, and an image path segment must start with a letter or digit.
# ${PROXY_NETWORK:-coolify} is interpolated by docker compose from the stack's environment (compose
# interpolates env_file values; checked with compose v5.5.1). PROXY_NETWORK must be a plain network name
# matching [A-Za-z0-9_-]+ because it lands in the regex unescaped (the provisioner's settings refuse others).
#
# Query strings (verified upstream, v1.14.0 cmd/socket-proxy/handlehttprequest.go): the proxy matches the
# allow regex against r.URL.Path only, never RawQuery. So these two are enforced by the provisioner alone:
#   - POST /containers/create?name=sb-...   the name always comes from names.ts (containerName)
#   - POST /images/create?fromImage=<REGISTRY>/...   spec.ts refuses any image outside
#     <REGISTRY>/selfbase-<service>:<version>; jobs use <REGISTRY>/selfbase-job:<TEMPLATE_VERSION>
# The proxy cannot see other request bodies (Privileged, host namespaces, volume DriverOpts, the Container of
# a network connect): that is the provisioner's spec builder (AC-11). Bind mount sources it does check
# (SP_ALLOWBINDMOUNTFROM). A blocked request, or one from another address, gets 403.
# ${REGISTRY} (image inspect) and ${BACKUP_HOST_DIR} come from the stack's environment like PROXY_NETWORK; the
# dots in REGISTRY stay regex wildcards, so the match is a little wider than the literal path.
# Only the verbs the provisioner sends (src/docker.ts, src/ops.ts): no /_ping, /info, kill, restart or wait.
# There is no disconnect on PROXY_NETWORK: the provisioner never detaches anything from the shared network,
# and the proxy cannot see which container a disconnect body names (any other team's would be an outage).
#
# The socket is root:root 0660 in most daemons; the compose service runs as user 65534 with the socket's gid.

SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
# hostname of the provisioner on the control network, resolved by the proxy on every request
SP_ALLOWFROM=selfbase-provisioner
SP_LOGLEVEL=INFO
# The proxy reads container create bodies for this one: a bind mount (Binds or Mounts type bind) from any
# other host path is 403. Unset BACKUP_HOST_DIR falls back to a path that is never used, so no bind passes.
SP_ALLOWBINDMOUNTFROM=${BACKUP_HOST_DIR:-/opt/selfbase/no-bind-mounts}

# The proxy container's inspect (GET /proxy: control trusts its address), by its exact name. PROXY_CONTAINER is
# [A-Za-z0-9_-]+ (the provisioner refuses others); selfbase-traefik is own mode's default, which compose cannot pick.
SP_ALLOW_GET=(/v1\.[0-9]+)?(/version|/containers/json|/containers/sb-[a-z0-9_-]+/(json|logs|stats)|/containers/(selfbase-traefik|${PROXY_CONTAINER:-coolify-proxy})/json|/volumes/sb-[a-z0-9_-]+|/networks/sb-[a-z0-9_-]+|/images/${REGISTRY:-selfbase.invalid}/selfbase-[a-z0-9_-]+:[A-Za-z0-9._-]+/json)
SP_ALLOW_POST=(/v1\.[0-9]+)?(/containers/create|/containers/sb-[a-z0-9_-]+/(start|stop)|/volumes/create|/networks/create|/networks/sb-[a-z0-9_-]+/(connect|disconnect)|/networks/${PROXY_NETWORK:-coolify}/connect|/images/create)
SP_ALLOW_DELETE=(/v1\.[0-9]+)?(/containers/sb-[a-z0-9_-]+|/volumes/sb-[a-z0-9_-]+|/networks/sb-[a-z0-9_-]+)
