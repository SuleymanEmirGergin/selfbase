# Allow-list for the own-Traefik socket proxy (compose profile `proxy`, PROXY_MODE=own; spec 7.3): read-only,
# Traefik's Docker provider only. wollomatic/socket-proxy:1.14.0 anchors each regex (^...$) itself and matches the
# path only. Every pattern takes an optional /v1.NN prefix. Anything else, or a request from another address: 403.
SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
# Traefik's container, resolved by the proxy on every request
SP_ALLOWFROM=selfbase-traefik
SP_LOGLEVEL=INFO
SP_ALLOW_GET=(/v1\.[0-9]+)?(/_ping|/version|/events|/networks(/[A-Za-z0-9_.-]+)?|/containers/json|/containers/[A-Za-z0-9_.-]+/json)
SP_ALLOW_HEAD=(/v1\.[0-9]+)?/_ping
