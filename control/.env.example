# selfbase control stack settings (control/compose.yml). Copy to /opt/selfbase/.env with mode 0600, never commit it.
# Secrets: (umask 077; docker run --rm <control image> node /app/scripts/gen-keys.mjs --control > /opt/selfbase/.env)
# Then add the settings below and check: docker run --rm -v /opt/selfbase/.env:/env:ro <control image> node /app/scripts/install-check.mjs /env
# Empty optional values take the default named in the comment. Fixed by compose, not settable here: CONTROL_DB_HOST,
# CONTROL_DB_PORT, PROVISIONER_URL, LOGS_URL, BACKUP_DIR (/backups), CONTROL_CONTAINER, CONTROL_NETWORK, DOCKER_HOST.

# ---- secrets (gen-keys --control) ----
# 32 random bytes, base64; encrypts every project secret. Keep an offline copy: losing it loses them all.
SELFBASE_MASTER_KEY=
# control-db's postgres password
CONTROL_DB_PASSWORD=
# signs dashboard sessions, at least 32 characters
CONTROL_JWT_SECRET=
# control's credential for the provisioner, at least 32 characters
PROVISIONER_TOKEN=

# ---- domain and images ----
# hostnames are <ref>.<BASE_DOMAIN> and selfbase.<BASE_DOMAIN>, e.g. <ip>.sslip.io
BASE_DOMAIN=
# Studio's public origin; default https://selfbase.<BASE_DOMAIN>. Its host must end with BASE_DOMAIN.
PUBLIC_URL=
# image registry path, e.g. ghcr.io/<owner>; images are <REGISTRY>/selfbase-<name>:<TEMPLATE_VERSION>
REGISTRY=
# release version of every image, e.g. 2.1.0
TEMPLATE_VERSION=

# ---- proxy (spec 7.3) ----
# coolify (route through coolify-proxy) or own (our Traefik; then also COMPOSE_PROFILES=proxy)
PROXY_MODE=
# the proxy's Docker network, external to this stack; coolify on a Coolify server. Must be the same everywhere:
# compose reads it for control's labels, the provisioner's settings and the socket-proxy allow-list.
PROXY_NETWORK=
# entrypoint of plain HTTP; default http (must be http with PROXY_MODE=own)
PROXY_ENTRYPOINT_HTTP=
# entrypoint of HTTPS; default https (must be https with PROXY_MODE=own)
PROXY_ENTRYPOINT_HTTPS=
# certificate resolver; letsencrypt on Coolify (required there). Empty: no ACME, Traefik's default certificate (local)
PROXY_CERTRESOLVER=
# major version of the proxy's Traefik, 3 (default) or 2; 2 also needs COMPOSE_FILE=compose.yml:compose.traefik-v2.yml
PROXY_TRAEFIK_MAJOR=
# own mode: host port of plain HTTP; default 80
PROXY_HTTP_PORT=
# own mode: host port of HTTPS; default 443
PROXY_HTTPS_PORT=
# own mode: Let's Encrypt account e-mail (optional)
ACME_EMAIL=
# proxy with PROXY_MODE=own (starts selfbase-traefik and its socket proxy); empty with PROXY_MODE=coolify
COMPOSE_PROFILES=
# compose files to use when not given with -f; set only for PROXY_TRAEFIK_MAJOR=2
COMPOSE_FILE=

# ---- hosts and certificates (AC-33) ----
# new hostnames per 7 days, control's own included; default 3 (sslip.io)
MAX_NEW_HOSTS_PER_WEEK=
# fixed host pool for branches; default 2
BRANCH_HOST_SLOTS=
# the one fixed host of throw-away test projects; default sb-test.<BASE_DOMAIN>
TEST_HOST=
# comma-separated hostnames under BASE_DOMAIN that already hold a certificate (v1's host)
LEGACY_HOSTNAMES=
# on (default): a project is healthy only once its own https URL answers; off: skip the probe (local only)
CERT_PROBE=

# ---- projects and capacity (spec 7.6) ----
# private range the projects' /27 networks are cut from, /16 or larger; default 10.207.0.0/16
PROJECT_SUBNET_POOL=
# MiB for all projects and shared services; default 16384
MEMORY_BUDGET_MB=
# admission factor; default 1.0 (CC-2: no overcommit)
OVERCOMMIT=
# MiB reserved for the shared stack; default 2720
SHARED_RESERVED_MB=
# MiB reserved for the one job slot; default 512
JOB_SLOT_MB=
# this server's name in control-db; default main
NODE_NAME=

# ---- host integration ----
# host directory for backups and exports, under /opt/selfbase/ (mode 0711: control reads exports' project.json)
BACKUP_HOST_DIR=
# days a scheduled backup is kept; default 7
BACKUP_RETENTION_DAYS=
# where project containers send their logs: udp://127.0.0.1:5514 (selfbase-logs). Empty: json-file logs only
LOG_SYSLOG_ADDR=
# cgroup parent of every selfbase container, e.g. selfbase.slice (systemd driver only). Empty: none
CGROUP_PARENT=
# group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock); default 0
DOCKER_SOCKET_GID=

# ---- dashboard e-mail and sign-in ----
# SMTP server for invitations and password resets; empty: links are shown in Studio instead
SMTP_HOST=
# SMTP port; default 587
SMTP_PORT=
# SMTP user name
SMTP_USER=
# SMTP password
SMTP_PASS=
# sender address of dashboard mail
SMTP_FROM=
# dashboard sign-ins per IP per 5 minutes; default 5
AUTH_RATE_LIMIT_SIGN_IN=
