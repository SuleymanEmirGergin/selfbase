# Secrets for the edge functions. Copy to fn.env (never commit it) and fill in what you use.
# Which functions run is set in .env, not here: SUPABASE_DIR = host path of the app's supabase/ folder
# (holds functions/ and config.toml; mounted read-only at /supabase). Unset, fn serves nothing (404).
# Names come from grepping Deno.env.get( across supabase/functions (tests excluded),
# plus the radar news provider keys read through provider.envKey.
#
# Provided by selfbase, do not set here:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL, JWT_SECRET
# Leave unset (new-style Supabase key maps; functions fall back to the keys above):
#   SUPABASE_SECRET_KEYS, SUPABASE_PUBLISHABLE_KEYS, EDGE_SECRET_KEY_NAME, EDGE_PUBLISHABLE_KEY_NAME

# Site
PUBLIC_SITE_URL=

# AI assistants
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
WABOT_ASSISTANT_SECRET=

# Mail (send-notification-emails)
MAIL_FROM=
MAIL_REPLY_TO=
NOTIFY_DISPATCH_SECRET=
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_AUTOREPLY_SECRET=
WHATSAPP_OTP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=
WHATSAPP_OTP_PHONE_PEPPER=

# Phone OTP / verification
SEND_SMS_HOOK_SECRET=
VERIFICATION_FAKE_PROVIDER=

# Radar news scan
RADAR_NEWS_CRON_SECRET=
RADAR_NEWS_MIN_SCORE=
RADAR_PROVIDERS_ENABLED=
RADAR_PROVIDER_ROTATION=
RADAR_PROVIDER_SCHEDULE=
RADAR_PROVIDER_WEIGHTS=
RADAR_SCAN_BUDGET_MS=
BING_NEWS_KEY=
